# Copy to .env.local for local development. None of these are required to run the site.
# On Vercel, set them under Project → Settings → Environment Variables (see docs/deployment.md).

# Canonical site URL (custom domain). Defaults to Vercel's production URL.
NEXT_PUBLIC_SITE_URL=

# Contact form (Resend). The form only appears when RESEND_API_KEY is set.
RESEND_API_KEY=
# Inbox that receives messages (defaults to contact.email in data/resume.ts)
CONTACT_TO=
# Verified sender, e.g. "Portfolio <hello@yourdomain.com>" (defaults to Resend's test sender)
CONTACT_FROM=
