{
    "$schema": "https://json.schemastore.org/prettierrc",
    "printWidth": 140,
    "tabWidth": 4,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "es5",
    "arrowParens": "avoid",
    "endOfLine": "lf",
    "overrides": [{ "files": ["*.yml", "*.yaml"], "options": { "tabWidth": 2 } }]
}
